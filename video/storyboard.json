            "portrait": {
              "x": 0.501,
              "y": 0.568
            }
          },
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              },
              {
                "eval": "() => { const pick = (probe, value) => { const sel = Array.from(document.querySelectorAll('select')).find((s) => Array.from(s.options).some((o) => o.value === probe)); if (!sel) throw new Error('no select carries option ' + probe); sel.value = value; sel.dispatchEvent(new Event('change', { bubbles: true })); }; pick('preview', 'preview'); pick('object', 'scene'); }"
              },
              {
                "waitFor": "select:has(option[value=\"preview\"]:checked)"
              },
              {
                "waitFor": "select:has(option[value=\"scene\"]:checked)"
              }
            ]
          }
        }
      ],
      "transition": "cut"
    },
