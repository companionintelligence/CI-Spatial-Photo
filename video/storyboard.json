{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-photo-time-machine",
    "name": "Photo Time Machine",
    "repo": "companionintelligence/CI-Photo-Time-Machine",
    "marketplaceId": "ci-photo-time-machine",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5,
    "pacing": "fit"
  },
  "chapters": {
    "create": "Make one",
    "explore": "Open it"
  },
  "media": {
    "music": null,
    "musicVolume": 0.14
  },
  "scenes": [
    {
      "id": "flat",
      "kind": "feature",
      "seconds": 5.5,
      "minSeconds": 4.5,
      "title": "1998. The porch, the sun going down.",
      "caption": "You were standing in it. The file kept one angle.",
      "narration": "A photograph has no depth. Your own server works it out.",
      "reveal": "paced"
    },
    {
      "id": "most-people-stop",
      "kind": "feature",
      "seconds": 5.5,
      "title": "Most people quit right about here.",
      "caption": "Depth normally means a GPU, or your picture on someone's disk.",
      "narration": "Depth normally means a GPU you do not own, or a service that keeps your file.",
      "reveal": "paced",
      "transition": "hold"
    },
    {
      "id": "open",
      "kind": "intro",
      "seconds": 5,
      "minSeconds": 4.5,
      "title": "Photo Time Machine",
      "caption": "One image in. A surface you can move around.",
      "narration": "Photo Time Machine does that work on hardware you already own.",
      "mark": "./assets/app-icon.png",
      "reveal": "paced",
      "transition": "cut"
    },
    {
      "id": "drop-media",
      "kind": "screen",
      "chapter": "create",
      "seconds": 6,
      "caption": "Drop an image, a burst, or a video.",
      "narration": "Open the viewer and drop one in. It goes to your own server, not a queue.",
      "shots": [
        {
          "id": "create-empty",
          "url": "photo-time-machine.local",
          "alt": "The Create tab, empty: dropzone, engine and intent selects, a disabled Create 3D button.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "text=Drop an image"
              },
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              }
            ]
          }
        },
        {
          "id": "create-selected",
          "url": "photo-time-machine.local",
          "alt": "The same dropzone after a drop: it names porch-1998.png and Create 3D has gone live.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "from-memory",
      "kind": "screen",
      "chapter": "create",
      "seconds": 7.5,
      "caption": "Or take one straight from Companion Memory.",
      "narration": "Your Companion already holds your library. Turn one into 3D without uploading anything.",
      "shots": [
        {
          "id": "memory-grid",
          "url": "photo-time-machine.local",
          "alt": "The From Memory tab: a Photos/Videos toggle above a grid of images already held in Companion Memory.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "click": "button:has-text(\"From Memory\")"
              },
              {
                "waitFor": "button:has-text(\"Photos\")"
              },
              {
                "waitFor": "img[alt=\"Porch at sunset, 1998\"]"
              }
            ]
          }
        },
        {
          "id": "memory-job",
          "url": "photo-time-machine.local",
          "alt": "One tap on the 1998 porch tile and the job is already reconstructing with preview — the library never left the box.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "click": "button:has-text(\"From Memory\")"
              },
              {
                "waitFor": "button:has-text(\"Photos\")"
              },
              {
                "waitFor": "img[alt=\"Porch at sunset, 1998\"]"
              },
              {
                "click": "button[title=\"Porch at sunset, 1998\"]"
              },
              {
                "waitFor": "text=Status: running"
              }
            ]
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "choose-engine",
      "kind": "screen",
      "chapter": "create",
      "seconds": 6,
      "caption": "Name the engine, or leave it on auto.",
      "narration": "Name the engine yourself, or leave it on auto and let the server infer it.",
      "shots": [
        {
          "id": "create-engine-picked",
          "url": "photo-time-machine.local",
          "alt": "The two selects driven off auto: Engine now reads preview, Intent now reads Scene (portal), with Create 3D live beneath them.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              },
              {
                "eval": "() => { const pick = (probe, value) => { const sel = Array.from(document.querySelectorAll('select')).find((s) => Array.from(s.options).some((o) => o.value === probe)); if (!sel) throw new Error('no select carries option ' + probe); sel.value = value; sel.dispatchEvent(new Event('change', { bubbles: true })); }; pick('preview', 'preview'); pick('object', 'scene'); }"
              },
              {
                "waitFor": "select:has(option[value=\"preview\"]:checked)"
              },
              {
                "waitFor": "select:has(option[value=\"scene\"]:checked)"
              }
            ]
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "job-running",
      "kind": "screen",
      "chapter": "create",
      "seconds": 6,
      "caption": "Reconstructing with preview, on your own box.",
      "narration": "It reads the input, picks an engine, and runs the job where the file already is.",
      "shots": [
        {
          "id": "create-processing",
          "url": "photo-time-machine.local",
          "alt": "The Create button one click later: it reads Processing, and the status line beneath reads reconstructing with preview.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              },
              {
                "click": "button:has-text(\"Create 3D\")"
              },
              {
                "waitFor": "text=Status: running"
              }
            ]
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "engines",
      "kind": "feature",
      "seconds": 7.5,
      "title": "What each engine actually does",
      "caption": "Preview lays it flat. Depth adds parallax. Many views rebuild.",
      "narration": "Preview lays the picture on a plane. Depth adds real parallax. Many views rebuild the scene.",
      "items": [
        {
          "label": "Preview",
          "value": "flat plane, no GPU"
        },
        {
          "label": "Depth image",
          "value": "real parallax, on CPU"
        },
        {
          "label": "Depth video",
          "value": "a clip, on CPU"
        },
        {
          "label": "TripoSplat",
          "value": "MIT, default"
        },
        {
          "label": "Photogrammetry",
          "value": "many views, GPU"
        },
        {
          "label": "SHARP",
          "value": "research only"
        }
      ],
      "reveal": "paced"
    },
    {
      "id": "plate-to-space",
      "kind": "split",
      "chapter": "explore",
      "seconds": 6.5,
      "caption": "The tile is flat. Open it and it stands in space.",
      "narration": "This one is the Preview engine: the picture itself, lifted onto a plane and turned.",
      "shots": [
        {
          "id": "gallery-assets",
          "url": "photo-time-machine.local",
          "alt": "The Explore tab: the finished splat as a gallery tile, labelled Splat, Preview and its creation date.",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "click": "button:has-text(\"Explore\")"
              },
              {
                "waitFor": "button:has(img[alt=\"preview\"])"
              }
            ]
          }
        },
        {
          "id": "viewer-orbit",
          "url": "photo-time-machine.local/view/a7989c36",
          "alt": "The same asset open in the viewer with the panel toggled away: one textured plane of Gaussians, tilted on its grid.",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 2500,
            "before": [
              {
                "click": "button:has-text(\"Explore\")"
              },
              {
                "click": "button:has(img[alt=\"preview\"])"
              },
              {
                "waitFor": "button:has-text(\"Copy link\")"
              },
              {
                "waitFor": "canvas"
              },
              {
                "waitFor": "[data-splat-status=\"ready\"]"
              },
              {
                "wait": 5000
              },
              {
                "eval": "(() => { window.requestAnimationFrame = () => 0; window.webkitRequestAnimationFrame = () => 0; })()"
              },
              {
                "click": "button[title=\"Toggle Controls\"]"
              },
              {
                "wait": 5000
              },
              {
                "eval": "() => { const s = document.createElement('style'); s.textContent = '[data-splat-status]{display:none !important}'; document.head.appendChild(s); }"
              }
            ]
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "whose-hardware",
      "kind": "screen",
      "chapter": "explore",
      "seconds": 6,
      "caption": "Splat · Preview, and a link that points at your box.",
      "narration": "Move around it. The panel names the engine, and the link points at your own box.",
      "shots": [
        {
          "id": "viewer-shared",
          "url": "photo-time-machine.local/view/a7989c36",
          "alt": "The viewer with its control panel up over the splat: the asset labelled Splat, Preview, and the share URL beside a Copy link button.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 2500,
            "before": [
              {
                "click": "button:has-text(\"Explore\")"
              },
              {
                "click": "button:has(img[alt=\"preview\"])"
              },
              {
                "waitFor": "button:has-text(\"Copy link\")"
              },
              {
                "waitFor": "canvas"
              },
              {
                "waitFor": "[data-splat-status=\"ready\"]"
              },
              {
                "wait": 5000
              },
              {
                "eval": "(() => { window.requestAnimationFrame = () => 0; window.webkitRequestAnimationFrame = () => 0; })()"
              },
              {
                "eval": "() => { const s = document.createElement('style'); s.textContent = '[data-splat-status]{display:none !important}'; document.head.appendChild(s); }"
              }
            ]
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "stays-yours",
      "kind": "feature",
      "seconds": 6.5,
      "title": "What stays yours",
      "caption": "The file, the engine, the link. All on your hardware.",
      "narration": "The file, the engine and the link all stay on hardware you own. Nothing to cancel.",
      "items": [
        {
          "label": "Files",
          "value": "your disk"
        },
        {
          "label": "Engines",
          "value": "your hardware"
        },
        {
          "label": "Share link",
          "value": "your box"
        },
        {
          "label": "From Memory",
          "value": "no upload step"
        },
        {
          "label": "Monthly fee",
          "value": "$0"
        }
      ],
      "reveal": "paced"
    },
    {
      "id": "close",
      "kind": "outro",
      "seconds": 5,
      "cta": "UnCloud your life.",
      "url": "ci.computer",
      "narration": "Photo Time Machine, from Companion Intelligence. UnCloud your life.",
      "mark": "brand:logo.full",
      "transition": "cut"
    }
  ]
}
