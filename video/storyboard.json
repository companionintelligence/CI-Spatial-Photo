      "id": "most-people-stop",
      "kind": "feature",
      "seconds": 5.5,
      "title": "Most people quit right about here.",
      "caption": "Depth normally means a GPU, or your picture on someone's disk.",
      "narration": "Depth normally means a GPU you do not own, or a service that keeps your file.",
      "items": [
        {
          "label": "Send it away",
          "value": "your file, their disk"
        },
        {
          "label": "Keep it home",
          "value": "a GPU you do not own"
        },
        {
          "label": "So mostly",
          "value": "the photo stays flat"
        }
      ],
      "reveal": "paced",
      "transition": "hold"
