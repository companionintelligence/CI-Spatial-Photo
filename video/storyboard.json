      "shots": [
        {
          "id": "create-engine-picked",
          "url": "photo-time-machine-living-room-server-acme.ci.computer",
          "alt": "The two selects driven off auto: Engine now reads preview, Intent now reads Scene (portal), with Create 3D live beneath them.",
          "motion": "drift-down",
          "focus": {
            "landscape": {
              "x": 0.405,
              "y": 0.28,
              "w": 0.55,
              "h": 0.55
