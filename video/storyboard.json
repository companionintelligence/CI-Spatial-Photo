{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-photo-time-machine",
    "name": "Photo Time Machine",
    "repo": "companionintelligence/CI-Photo-Time-Machine",
    "marketplaceId": "ci-photo-time-machine",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5,
    "pacing": "fit"
  },
  "chapters": {
    "create": "Create",
    "explore": "Explore",
    "share": "Share"
  },
  "media": {
    "music": null,
    "musicVolume": 0.14
  },
  "scenes": [
    {
      "id": "open",
      "kind": "intro",
      "seconds": 5,
      "title": "Photo Time Machine",
      "caption": "A photo goes in. A 3D memory comes out.",
      "narration": "Photo Time Machine turns one photo into a 3D memory."
    },
    {
      "id": "drop-media",
      "kind": "screen",
      "chapter": "create",
      "seconds": 6,
      "caption": "Drop an image, a set of images, or a video.",
      "narration": "Open the viewer. Drop in a photo, a burst, or a video.",
      "shots": [
        {
          "id": "create-empty",
          "url": "photo-time-machine.local",
          "alt": "The Create tab, empty: dropzone, engine and intent selects, a disabled Create 3D button.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "text=Drop an image"
              },
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              }
            ]
          }
        },
        {
          "id": "create-selected",
          "url": "photo-time-machine.local",
          "alt": "The same dropzone after a drop: it names porch-1998.png and Create 3D has gone live.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "choose-engine",
      "kind": "screen",
      "chapter": "create",
      "seconds": 6,
      "caption": "Pick an engine and an intent, or leave both on auto.",
      "narration": "Pick an engine and an intent, or leave both on auto.",
      "shots": [
        {
          "id": "create-selected",
          "url": "photo-time-machine.local",
          "alt": "The armed Create tab with Engine on Auto (recommended) and Intent on Auto.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              }
            ]
          }
        },
        {
          "id": "create-engine-picked",
          "url": "photo-time-machine.local",
          "alt": "The same two selects driven off auto: Engine now reads triposplat, Intent now reads Object (full 3D).",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              },
              {
                "eval": "() => { const pick = (probe, value) => { const sel = Array.from(document.querySelectorAll('select')).find((s) => Array.from(s.options).some((o) => o.value === probe)); if (!sel) throw new Error('no select carries option ' + probe); sel.value = value; sel.dispatchEvent(new Event('change', { bubbles: true })); }; pick('preview', 'triposplat'); pick('object', 'object'); }"
              },
              {
                "waitFor": "select:has(option[value=\"triposplat\"]:checked)"
              },
              {
                "waitFor": "select:has(option[value=\"object\"]:checked)"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "job-running",
      "kind": "screen",
      "chapter": "create",
      "seconds": 6,
      "caption": "The server classifies the input and routes it to an engine.",
      "narration": "The server reads the input, picks an engine, and runs the job.",
      "shots": [
        {
          "id": "create-selected",
          "url": "photo-time-machine.local",
          "alt": "Create 3D armed and waiting, one image staged in the dropzone.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 500,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              }
            ]
          }
        },
        {
          "id": "create-processing",
          "url": "photo-time-machine.local",
          "alt": "The same button one click later: it reads Processing, and a status line reads reconstructing with preview.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "waitFor": "select:has(option[value=\"preview\"])"
              },
              {
                "eval": "window.__ciVideoPickFixture()"
              },
              {
                "waitFor": "text=file(s) selected"
              },
              {
                "click": "button:has-text(\"Create 3D\")"
              },
              {
                "waitFor": "text=Status: running"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "from-memory",
      "kind": "screen",
      "chapter": "create",
      "seconds": 7.5,
      "caption": "Pull straight from Companion memory. No upload step.",
      "narration": "Your Companion already holds your photos. Turn one into 3D without uploading anything.",
      "shots": [
        {
          "id": "memory-grid",
          "url": "photo-time-machine.local",
          "alt": "The From Memory tab: a Photos/Videos toggle above a grid of photos already in Companion memory.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "click": "button:has-text(\"From Memory\")"
              },
              {
                "waitFor": "button:has-text(\"Photos\")"
              },
              {
                "waitFor": "img[alt=\"Porch at sunset, 1998\"]"
              }
            ]
          }
        },
        {
          "id": "memory-job",
          "url": "photo-time-machine.local",
          "alt": "One tap on the 1998 porch photo and the job is already reconstructing with preview — the library never left the box.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "click": "button:has-text(\"From Memory\")"
              },
              {
                "waitFor": "button:has-text(\"Photos\")"
              },
              {
                "waitFor": "img[alt=\"Porch at sunset, 1998\"]"
              },
              {
                "click": "button[title=\"Porch at sunset, 1998\"]"
              },
              {
                "waitFor": "text=Status: running"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "engines",
      "kind": "feature",
      "seconds": 6,
      "title": "Pluggable engines",
      "caption": "One interface. Swap the reconstruction underneath.",
      "narration": "Four engines behind one interface. Preview needs no GPU at all.",
      "items": [
        {
          "label": "Preview",
          "value": "CPU, always on"
        },
        {
          "label": "TripoSplat",
          "value": "MIT, default"
        },
        {
          "label": "SHARP",
          "value": "research only"
        },
        {
          "label": "Photogrammetry",
          "value": "video to splat"
        }
      ]
    },
    {
      "id": "explore-gallery",
      "kind": "screen",
      "chapter": "explore",
      "seconds": 6,
      "caption": "Every finished memory becomes a tile you can open.",
      "narration": "Finished assets land in the gallery. Click one to open it.",
      "shots": [
        {
          "id": "gallery-assets",
          "url": "photo-time-machine.local",
          "alt": "The Explore tab: the finished splat as a gallery tile, labelled with its kind, engine and creation time.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 600,
            "before": [
              {
                "click": "button:has-text(\"Explore\")"
              },
              {
                "waitFor": "button:has(img[alt=\"preview\"])"
              }
            ]
          }
        },
        {
          "id": "viewer-shared",
          "url": "photo-time-machine.local/view/a7989c36",
          "alt": "The same tile clicked: the splat is loaded behind the panel and the address bar has become the share link.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 2500,
            "before": [
              {
                "click": "button:has-text(\"Explore\")"
              },
              {
                "click": "button:has(img[alt=\"preview\"])"
              },
              {
                "waitFor": "button:has-text(\"Copy link\")"
              },
              {
                "waitFor": "canvas"
              },
              {
                "waitFor": "[data-splat-status=\"ready\"]"
              },
              {
                "wait": 5000
              },
              {
                "eval": "(() => { window.requestAnimationFrame = () => 0; window.webkitRequestAnimationFrame = () => 0; })()"
              },
              {
                "eval": "() => { const s = document.createElement('style'); s.textContent = '[data-splat-status]{display:none !important}'; document.head.appendChild(s); }"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "orbit-memory",
      "kind": "screen",
      "chapter": "explore",
      "seconds": 7,
      "caption": "Hide the panel and orbit the memory itself.",
      "narration": "Hide the panel and orbit the memory itself. Nothing left your hardware to render it.",
      "shots": [
        {
          "id": "viewer-shared",
          "url": "photo-time-machine.local/view/a7989c36",
          "alt": "The viewer with the control panel still up, the splat rendering behind it.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 2500,
            "before": [
              {
                "click": "button:has-text(\"Explore\")"
              },
              {
                "click": "button:has(img[alt=\"preview\"])"
              },
              {
                "waitFor": "button:has-text(\"Copy link\")"
              },
              {
                "waitFor": "canvas"
              },
              {
                "waitFor": "[data-splat-status=\"ready\"]"
              },
              {
                "wait": 5000
              },
              {
                "eval": "(() => { window.requestAnimationFrame = () => 0; window.webkitRequestAnimationFrame = () => 0; })()"
              },
              {
                "eval": "() => { const s = document.createElement('style'); s.textContent = '[data-splat-status]{display:none !important}'; document.head.appendChild(s); }"
              }
            ]
          }
        },
        {
          "id": "viewer-orbit",
          "url": "photo-time-machine.local/view/a7989c36",
          "alt": "The panel toggled away: the reconstructed splat alone, full bleed, on its grid.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 2500,
            "before": [
              {
                "click": "button:has-text(\"Explore\")"
              },
              {
                "click": "button:has(img[alt=\"preview\"])"
              },
              {
                "waitFor": "button:has-text(\"Copy link\")"
              },
              {
                "waitFor": "canvas"
              },
              {
                "waitFor": "[data-splat-status=\"ready\"]"
              },
              {
                "wait": 5000
              },
              {
                "eval": "(() => { window.requestAnimationFrame = () => 0; window.webkitRequestAnimationFrame = () => 0; })()"
              },
              {
                "click": "button[title=\"Toggle Controls\"]"
              },
              {
                "wait": 5000
              },
              {
                "eval": "() => { const s = document.createElement('style'); s.textContent = '[data-splat-status]{display:none !important}'; document.head.appendChild(s); }"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "share-link",
      "kind": "screen",
      "chapter": "share",
      "seconds": 5,
      "caption": "Every memory gets a link, ready to copy.",
      "narration": "The address bar is the share link. It points at your box.",
      "shots": [
        {
          "id": "viewer-shared",
          "url": "photo-time-machine.local/view/a7989c36",
          "alt": "The panel back up, showing the share URL for this memory beside a Copy link button.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitFor": "button:has-text(\"Create 3D\")",
            "waitUntil": "networkidle",
            "settle": 2500,
            "before": [
              {
                "click": "button:has-text(\"Explore\")"
              },
              {
                "click": "button:has(img[alt=\"preview\"])"
              },
              {
                "waitFor": "button:has-text(\"Copy link\")"
              },
              {
                "waitFor": "canvas"
              },
              {
                "waitFor": "[data-splat-status=\"ready\"]"
              },
              {
                "wait": 5000
              },
              {
                "eval": "(() => { window.requestAnimationFrame = () => 0; window.webkitRequestAnimationFrame = () => 0; })()"
              },
              {
                "eval": "() => { const s = document.createElement('style'); s.textContent = '[data-splat-status]{display:none !important}'; document.head.appendChild(s); }"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "companion-native",
      "kind": "feature",
      "seconds": 6,
      "title": "Companion-native",
      "caption": "Agents can drive it. The 3D stays on your hardware.",
      "narration": "Agents create and share these over MCP. The files stay on your hardware.",
      "items": [
        {
          "label": "MCP tools",
          "value": "seven"
        },
        {
          "label": "Sign-in",
          "value": "Companion OIDC"
        },
        {
          "label": "Memory",
          "value": "Companion Memory"
        },
        {
          "label": "Viewer",
          "value": "browser and XR"
        }
      ]
    },
    {
      "id": "close",
      "kind": "outro",
      "seconds": 5,
      "cta": "UnCloud your life.",
      "url": "ci.computer",
      "narration": "Photo Time Machine. Companion Intelligence. UnCloud your life."
    }
  ]
}
