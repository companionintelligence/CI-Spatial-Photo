# ── CI Photo Time Machine configuration ───────────────────────────────────────
# Copy to `.env` and adjust. All of these are read by the server (server/app/config.py).

# Public base URL used to build share links (/view/:assetId). Point at the viewer.
PUBLIC_BASE_URL=http://localhost:3000

# ── Auth (Companion OIDC) ──────────────────────────────────────────────────────
# For local hacking, leave AUTH_DISABLED=1. In the Companion Hub this is provisioned
# automatically and AUTH_DISABLED should be 0.
AUTH_DISABLED=1
COMPANION_OIDC_ISSUER=
COMPANION_OIDC_AUDIENCE=

# ── Companion memory (CI-Server / Hermes memory MCP) ───────────────────────────
# When set, every created asset is written to Companion memory over MCP. Leave blank
# for fully local mode (no memory writes).
CI_MEMORY_MCP_URL=

# ── Engines ────────────────────────────────────────────────────────────────────
DEFAULT_ENGINE=triposplat
# Apple SHARP weights are non-commercial research only; keep disabled for product use.
SHARP_ENABLE_RESEARCH=0
# Where TripoSplat / SHARP weights are cached inside the container.
MODEL_WEIGHTS_DIR=/models

# ── MCP transport security ─────────────────────────────────────────────────────
# Hostnames /mcp may be reached by, comma-separated (`host:*` accepts any port). The MCP
# streamable-HTTP transport validates the Host header for DNS-rebinding protection, and the
# allowlist it builds itself is loopback-only. Behind any reverse proxy — nginx, a Cloudflare
# Tunnel, the photo.ci.computer Worker — the inbound Host is the public name, and /mcp answers
# 421 "Invalid Host header" to every agent while REST carries on working. Loopback is always
# allowed, so local development needs nothing here.
MCP_ALLOWED_HOSTS=
# Origins allowed to speak MCP from a browser. Agents send no Origin header. Defaults to
# https:// + each allowed host.
MCP_ALLOWED_ORIGINS=

# ── Storage ────────────────────────────────────────────────────────────────────
ASSET_DIR=./data/assets
